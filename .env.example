# Copy to .env — every value is optional; defaults shown.

# --- Web / API ---
API_PORT=4000
# Only needed when the browser talks to the API from another origin (Vite proxies in dev,
# nginx proxies in Docker).
CORS_ORIGIN=http://localhost:5173
WEB_PORT=8080
# DATA_DIR holds temporary frames and session images; docker-compose uses /tmp/parking-vision.
# DATA_DIR=./data

# --- Camera polling ---
POLL_INTERVAL_SECONDS=5
FRAME_RETENTION=20

# --- Vehicle detection ---
# DETECTOR=replicate uses Replicate; DETECTOR=fake returns fixture boxes (no token needed).
DETECTOR=replicate
REPLICATE_MODEL=adirik/grounding-dino:efd10a8ddc57ea28773327e881ce95e20cc1d734c589f7dd01d2036921ed78aa
# JSON input sent to the model; "{image}" is replaced by the frame as a data URI.
REPLICATE_INPUT_TEMPLATE={"image": "{image}", "query": "car", "box_threshold": 0.15, "text_threshold": 0.15, "show_visualisation": false}
# Output parser: grounding_dino | yolo
REPLICATE_OUTPUT_FORMAT=grounding_dino
DETECTION_UPSCALE=3
DETECTION_MIN_CONFIDENCE=0.15
DETECTION_MAX_BOX_AREA=0.2
# Replicate allows 6 predictions/min (burst 1) on accounts with < $5 credit; keep this low then.
MAX_CONCURRENT_PREDICTIONS=4

# --- View recognition / occupancy ---
# Banner area ignored when matching viewpoints, normalised x,y,w,h
VIEW_MASK=0,0,1,0.09
AVAILABLE_CONFIRM_FRAMES=2
